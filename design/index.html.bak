              <p class="page-sub">Unplanned outages and degradations. A major incident can later collect the related tickets.</p>
            </div>
            <button class="btn btn-primary" type="button" data-for="agent manager">Declare incident</button>
          </div>
          <div class="card" style="padding:8px 8px 0">
            <table>
              <thead><tr><th>Incident</th><th>Severity</th><th>Status</th><th>Owner</th><th>Updated</th></tr></thead>
              <tbody>
                <tr class="clickable" data-go="incident"><td><div class="mono">INC-208</div><div class="subject">Organization-wide login failures</div></td><td><span class="pill critical">Critical</span></td><td><span class="pill progress">Investigating</span></td><td>K. Fernando</td><td>14:04</td></tr>
                <tr class="clickable" data-go="incident"><td><div class="mono">INC-201</div><div class="subject">Mail gateway delay</div></td><td><span class="pill high">High</span></td><td><span class="pill open">Monitoring</span></td><td>N. Silva</td><td>11:40</td></tr>
                <tr class="clickable" data-go="incident"><td><div class="mono">INC-188</div><div class="subject">File share read-only</div></td><td><span class="pill medium">Medium</span></td><td><span class="pill resolved">Resolved</span></td><td>P. Dias</td><td>2 Nov</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="view" data-view="incident" data-for="agent manager admin">
          <div class="head-row">
            <div>
              <div class="kicker mono">INC-208 · Identity</div>
              <h1 class="page-title">Organization-wide login failures</h1>
              <p class="page-sub">People can open ServiceOps and mail, then get rejected at the directory. Started 13:12.</p>
            </div>
            <span class="pill critical">Critical</span>
          </div>
          <div class="layout-ticket">
            <div class="stack">
              <div class="card">
                <h3>Investigation</h3>
                <ol class="timeline">
                  <li><i></i><div><strong>Declared by N. Silva</strong><div class="hint">13:18 · Directory timeouts on two domain controllers</div></div></li>
                  <li><i></i><div><strong>Owner set to K. Fernando</strong><div class="hint">13:26 · Escalated from the service desk</div></div></li>
                  <li><i></i><div><strong>Mitigation</strong><div class="hint">13:58 · Authentication pointed at the secondary controller. New sign-ins succeeding.</div></div></li>
                </ol>
              </div>
              <div class="card">
                <h3>Related requests <span class="hint">Extended</span></h3>
                <p class="page-sub">Major-incident linking is an extended release. The layout reserves a place for the tickets that describe the same outage.</p>
                <table>
                  <thead><tr><th>Ticket</th><th>Requester</th></tr></thead>
                  <tbody>
                    <tr><td class="mono">TKT-1051</td><td>Floor 4 cannot sign in</td></tr>
                    <tr><td class="mono">TKT-1054</td><td>Shared kiosk login loop</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
            <aside class="card">
              <h3>Command</h3>
              <div class="meta-list">
                <div><dt>Severity</dt><dd>Critical</dd></div>
                <div><dt>Status</dt><dd>Investigating</dd></div>
                <div><dt>Reporter</dt><dd>N. Silva</dd></div>
                <div><dt>Owner</dt><dd>K. Fernando</dd></div>
              </div>
              <div class="field" style="margin-top:12px" data-for="manager">
                <label for="inc-owner">Reassign owner</label>
                <select id="inc-owner"><option>K. Fernando</option><option>N. Silva</option><option>P. Dias</option></select>
              </div>
              <button class="btn btn-primary btn-block" type="button" data-for="agent manager" style="margin-top:8px">Record update</button>
            </aside>
          </div>
        </section>

        <section class="view" data-view="assignment" data-for="manager">
          <div class="head-row">
            <div>
              <div class="kicker">Assignment</div>
              <h1 class="page-title">Give every open ticket an owner.</h1>
              <p class="page-sub">Unassigned work sits on the left. Capacity sits on the right so the next ticket does not land on the busiest agent.</p>
            </div>
          </div>
          <div class="split">
            <div class="card">
              <h3>Unassigned · 3</h3>
              <table>
                <thead><tr><th>Ticket</th><th>Priority</th><th>Waiting</th><th></th></tr></thead>
                <tbody>
                  <tr>
                    <td><div class="mono">TKT-1038</div><div class="subject">VPN drops on floor 4</div></td>
                    <td><span class="pill critical">Critical</span></td><td>26m past response</td>
                    <td><button class="btn btn-primary" type="button">Assign</button></td>
                  </tr>
                  <tr>
                    <td><div class="mono">TKT-1055</div><div class="subject">Monitor flicker, reception</div></td>
                    <td><span class="pill medium">Medium</span></td><td>18m</td>
                    <td><button class="btn btn-ghost" type="button">Assign</button></td>
                  </tr>
                  <tr>
                    <td><div class="mono">TKT-1056</div><div class="subject">Guest Wi-Fi passphrase</div></td>
                    <td><span class="pill low">Low</span></td><td>9m</td>
                    <td><button class="btn btn-ghost" type="button">Assign</button></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="card">
              <h3>Who can take it</h3>
              <div class="load">
                <div><span>A. Rahman</span><div class="track"><span style="width:34%"></span></div><b>4</b></div>
                <div><span>P. Dias</span><div class="track"><span style="width:50%"></span></div><b>6</b></div>
                <div><span>N. Silva</span><div class="track"><span style="width:66%"></span></div><b>8</b></div>
                <div><span>R. Chen</span><div class="track"><span style="width:92%"></span></div><b>11</b></div>
              </div>
              <p class="hint" style="margin-top:12px">Skill-based routing is a later release. This screen is the manual desk.</p>
            </div>
          </div>
        </section>

        <section class="view" data-view="sla" data-for="manager admin">
          <div class="head-row">
            <div>
              <div class="kicker">SLA</div>
              <h1 class="page-title">Response and resolution targets</h1>
              <p class="page-sub">Policies match priority. Business hours are Colombo weekdays, 08:00 to 18:00. Pending pauses the clock.</p>
            </div>
            <button class="btn btn-primary" type="button">New policy</button>
          </div>
          <div class="card">
            <div class="policy" style="color:var(--muted);font-size:12px;letter-spacing:.06em;text-transform:uppercase"><span>Policy</span><span>Response</span><span>Resolution</span><span>State</span></div>
            <div class="policy"><div><strong>Critical</strong><div class="hint">Service down for a team</div></div><span>15 min</span><span>4 hours</span><span class="pill ok">Active</span></div>
            <div class="policy"><div><strong>High</strong><div class="hint">One person blocked</div></div><span>1 hour</span><span>8 hours</span><span class="pill ok">Active</span></div>
            <div class="policy"><div><strong>Medium</strong><div class="hint">Standard request</div></div><span>4 hours</span><span>24 hours</span><span class="pill ok">Active</span></div>
            <div class="policy"><div><strong>Low</strong><div class="hint">Can wait for a planned slot</div></div><span>8 hours</span><span>72 hours</span><span class="pill ok">Active</span></div>
          </div>
          <p class="note" style="margin-top:12px">Changing a target creates the next version. Tickets already running keep the snapshot they were given. Holidays are deferred until calendar-time policies are proven.</p>
        </section>

        <section class="view" data-view="reports" data-for="manager admin">
          <div class="head-row">
            <div>
              <div class="kicker">Reports</div>
              <h1 class="page-title">Service quality, 27 Oct – 5 Nov</h1>
              <p class="page-sub">Filter by date and export the rows you are allowed to see. Figures follow the same scope as the role.</p>
            </div>
            <button class="btn btn-ghost" type="button">Export CSV</button>
          </div>
          <div class="filters">
            <button type="button" aria-pressed="true">Last 10 days</button>
            <button type="button" aria-pressed="false">This month</button>
            <button type="button" aria-pressed="false">By category</button>
            <button type="button" aria-pressed="false">By agent</button>
          </div>
          <div class="stats">
            <div class="stat"><span>Opened</span><strong>86</strong><em>Tickets</em></div>
            <div class="stat"><span>Resolved</span><strong>79</strong><em>Tickets</em></div>
            <div class="stat good"><span>Response met</span><strong>96%</strong><em>Of measured tickets</em></div>
            <div class="stat"><span>Resolution met</span><strong>91%</strong><em>Of measured tickets</em></div>
          </div>
          <div class="card" style="padding:8px 8px 0">
            <table>
              <thead><tr><th>Category</th><th>Opened</th><th>Median response</th><th>Breaches</th></tr></thead>
              <tbody>
                <tr><td>Hardware</td><td>28</td><td>44 min</td><td>1</td></tr>
                <tr><td>Access</td><td>24</td><td>31 min</td><td>0</td></tr>
                <tr><td>Network</td><td>19</td><td>22 min</td><td>2</td></tr>
                <tr><td>Software</td><td>15</td><td>1 h 10 m</td><td>0</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="view" data-view="people" data-for="admin">
          <div class="head-row">
            <div>
              <div class="kicker">People</div>
              <h1 class="page-title">Accounts and roles</h1>
              <p class="page-sub">Self-registration receives Employee. Only an administrator can grant Agent, Manager, or Administrator. Deactivate instead of deleting history.</p>
            </div>
            <button class="btn btn-primary" type="button">Invite person</button>
          </div>
          <div class="card" style="padding:8px 8px 0">
            <table>
              <thead><tr><th>Person</th><th>Email</th><th>Roles</th><th>Status</th></tr></thead>
              <tbody>
                <tr><td>Amina Perera</td><td class="mono">amina.perera@northwind.example</td><td>Employee</td><td><span class="pill ok">Active</span></td></tr>
                <tr><td>R. Chen</td><td class="mono">r.chen@northwind.example</td><td>Agent</td><td><span class="pill ok">Active</span></td></tr>
                <tr><td>N. Silva</td><td class="mono">n.silva@northwind.example</td><td>Agent</td><td><span class="pill ok">Active</span></td></tr>
                <tr><td>K. Fernando</td><td class="mono">k.fernando@northwind.example</td><td>Manager</td><td><span class="pill ok">Active</span></td></tr>
                <tr><td>S. Jayawardena</td><td class="mono">s.jaya@northwind.example</td><td>Administrator</td><td><span class="pill ok">Active</span></td></tr>
                <tr><td>Guest kiosk</td><td class="mono">kiosk@northwind.example</td><td>Employee</td><td><span class="pill breach">Locked</span></td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="view" data-view="categories" data-for="admin">
          <div class="head-row">
            <div>
              <div class="kicker">Catalog</div>
              <h1 class="page-title">Ticket categories</h1>
              <p class="page-sub">Retire a category by marking it inactive. Tickets already filed keep the name.</p>
            </div>
            <button class="btn btn-primary" type="button">Add category</button>
          </div>
          <div class="cats">
            <article class="card"><h3>Hardware</h3><p class="hint">Laptops, docks, printers, monitors. Active.</p></article>
            <article class="card"><h3>Access</h3><p class="hint">Accounts, mailboxes, VPN, passwords. Active.</p></article>
            <article class="card"><h3>Software</h3><p class="hint">Installs and license requests. Active.</p></article>
            <article class="card"><h3>Network</h3><p class="hint">Wi-Fi, floors, and outages. Active.</p></article>
          </div>
        </section>

        <section class="view" data-view="audit" data-for="admin">
          <div class="head-row">
            <div>
              <div class="kicker">Audit</div>
              <h1 class="page-title">What changed, and who did it</h1>
              <p class="page-sub">Sign-ins, role grants, assignment, status changes, and SLA edits. These rows cannot be edited from the product.</p>
            </div>
          </div>
          <div class="card" style="padding:8px 8px 0">
            <table>
              <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Resource</th></tr></thead>
              <tbody>
                <tr><td class="mono">5 Nov 14:02</td><td>K. Fernando</td><td>ticket.assign</td><td class="mono">TKT-1038</td></tr>
                <tr><td class="mono">5 Nov 13:18</td><td>N. Silva</td><td>incident.create</td><td class="mono">INC-208</td></tr>
                <tr><td class="mono">5 Nov 11:20</td><td>S. Jayawardena</td><td>role.grant</td><td>P. Dias · Agent</td></tr>
                <tr><td class="mono">5 Nov 09:05</td><td>System</td><td>auth.lock</td><td>kiosk@northwind.example</td></tr>
                <tr><td class="mono">4 Nov 16:40</td><td>S. Jayawardena</td><td>sla.policy.update</td><td>High · resolution 8h</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="view" data-view="settings" data-for="admin">
          <div class="head-row">
            <div>
              <div class="kicker">Settings</div>
              <h1 class="page-title">This organization</h1>
              <p class="page-sub">One organization for the first release. Time, email, and retention live here.</p>
            </div>
          </div>
          <div class="split">
            <form class="card stack">
              <div class="field"><label for="org">Organization name</label><input id="org" value="Northwind Internal IT" /></div>
              <div class="field"><label for="tz">Timezone</label><input id="tz" value="Asia/Colombo" /></div>
              <div class="field"><label for="from">Notification sender</label><input id="from" value="serviceops@northwind.example" /></div>
              <div class="field"><label for="keep">Ticket retention</label><select id="keep"><option>Keep for 24 months, then archive</option><option>Keep indefinitely</option></select></div>
              <button class="btn btn-primary" type="button" style="justify-self:start">Save settings</button>
            </form>
            <div class="note">Passwords, refresh tokens, and raw email credentials are never shown on this screen and never written into the audit payload.</div>
          </div>
        </section>

        <section class="view" data-view="knowledge" data-for="employee agent manager">
          <div class="head-row">
            <div>
              <div class="kicker">Knowledge · Extended</div>
              <h1 class="page-title">Solve it before you file a ticket.</h1>
              <p class="page-sub">Published guides for the organization. Rating and ticket links arrive with the knowledge module.</p>
            </div>
          </div>
          <div class="field" style="max-width:520px"><label for="kb">Search articles</label><input id="kb" value="password" /></div>
          <div class="card" style="margin-top:12px">
            <article class="article"><div><strong>Reset a forgotten Windows password</strong><p class="hint">Access · 4 min · Updated 1 Nov</p></div><span class="pill ok">Published</span></article>
            <article class="article"><div><strong>Connect to the office VPN</strong><p class="hint">Network · 3 min</p></div><span class="pill ok">Published</span></article>
            <article class="article"><div><strong>Clear a printer jam on the 3rd floor</strong><p class="hint">Hardware · 2 min</p></div><span class="pill ok">Published</span></article>
            <article class="article"><div><strong>Request a software install</strong><p class="hint">Software · 2 min</p></div><span class="pill pending">Draft</span></article>
          </div>
        </section>

        <section class="view" data-view="assets" data-for="manager">
          <div class="head-row">
            <div>
              <div class="kicker">Assets · Extended</div>
              <h1 class="page-title">Equipment tied to the person and the ticket.</h1>
              <p class="page-sub">Not in the first release. The screen shows how a dock ticket would meet the laptop record.</p>
            </div>
          </div>
          <div class="card" style="padding:8px 8px 0">
            <table>
              <thead><tr><th>Asset</th><th>Holder</th><th>Status</th><th>Warranty</th><th>Open ticket</th></tr></thead>
              <tbody>
                <tr><td><div class="mono">LAT-5440-18</div><div>Dell Latitude 5440</div></td><td>Amina Perera</td><td><span class="pill progress">In repair</span></td><td>Aug 2027</td><td class="mono">TKT-1042</td></tr>
                <tr><td><div class="mono">DOCK-04-12</div><div>USB-C dock</div></td><td>Finance pool</td><td><span class="pill breach">Failed</span></td><td>Jan 2026</td><td class="mono">TKT-1042</td></tr>
                <tr><td><div class="mono">PRN-3F-02</div><div>HP Laser, 3rd floor</div></td><td>Shared</td><td><span class="pill ok">In service</span></td><td>Mar 2028</td><td class="mono">—</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="view" data-view="denied">
          <div class="denied">
            <div class="kicker">Access</div>
            <h1 class="page-title">This desk is not on your role.</h1>
            <p class="page-sub">The server refuses the page, not only the menu. Ask an administrator if your work needs a different role.</p>
            <button class="btn btn-primary" type="button" data-go="home" style="margin-top:16px">Back to your home</button>
          </div>
        </section>

      </main>
    </div>
  </div>

<script>
const screens = [
  ["login", "Sign in"],
  ["reset", "Forgot password"],
  ["home", "Home"],
  ["tickets", "Requests"],
  ["new", "New request"],
  ["ticket", "Ticket"],
  ["notifications", "Inbox"],
  ["incidents", "Incidents"],
  ["incident", "Incident"],
  ["assignment", "Assignment"],
  ["sla", "SLA policies"],
  ["reports", "Reports"],
  ["people", "People and roles"],
  ["categories", "Categories"],
  ["audit", "Audit log"],
  ["settings", "Settings"],
  ["knowledge", "Knowledge"],
  ["assets", "Assets"]
];
const access = {
  employee: ["home", "tickets", "new", "ticket", "notifications", "knowledge"],
  agent: ["home", "tickets", "ticket", "notifications", "incidents", "incident", "knowledge"],
  manager: ["home", "tickets", "ticket", "notifications", "incidents", "incident", "assignment", "sla", "reports", "knowledge", "assets"],
  admin: ["home", "tickets", "ticket", "notifications", "incidents", "incident", "sla", "reports", "people", "categories", "audit", "settings"]
};
const navItems = {
  employee: [["home", "Home"], ["tickets", "My requests"], ["new", "New request"], ["knowledge", "Knowledge"], ["notifications", "Inbox"]],
  agent: [["home", "Queue"], ["tickets", "All tickets"], ["incidents", "Incidents"], ["knowledge", "Knowledge"], ["notifications", "Inbox"]],
  manager: [["home", "Overview"], ["tickets", "Tickets"], ["assignment", "Assignment"], ["incidents", "Incidents"], ["sla", "SLA"], ["reports", "Reports"], ["assets", "Assets"]],
  admin: [["home", "Platform"], ["people", "People"], ["categories", "Categories"], ["sla", "SLA"], ["reports", "Reports"], ["audit", "Audit"], ["settings", "Settings"]]
};
const people = {
  employee: { name: "Amina Perera", role: "Employee · Finance", avatar: "AP", email: "amina.perera@northwind.example" },
  agent: { name: "R. Chen", role: "IT Support Agent", avatar: "RC", email: "r.chen@northwind.example" },
  manager: { name: "K. Fernando", role: "IT Manager", avatar: "KF", email: "k.fernando@northwind.example" },
  admin: { name: "S. Jayawardena", role: "System Administrator", avatar: "SJ", email: "s.jaya@northwind.example" }
};
const copy = {
  employee: ["Your requests", "My requests", "Everything you have submitted, including closed work kept for history."],
  agent: ["Queue", "All visible tickets", "Work you are allowed to open, with SLA state beside the status."],
  manager: ["Organization", "Every open ticket", "Assign, reassign, and watch breaches across the service desk."],
  admin: ["Records", "Ticket register", "Administrators can read tickets. Assignment stays with managers."]
};

const jump = document.getElementById("screen-jump");
screens.forEach(([id, label]) => {
  const opt = document.createElement("option");
  opt.value = id;
  opt.textContent = label;
  jump.appendChild(opt);
});

let role = "employee";
let view = "login";

function applyRoleVisibility() {
  document.body.dataset.role = role;
  document.querySelectorAll("[data-for]:not(.view)").forEach((el) => {
    el.hidden = !el.dataset.for.split(" ").includes(role);
  });
  const person = people[role];
  document.getElementById("who-name").textContent = person.name;
  document.getElementById("who-role").textContent = person.role;
  document.getElementById("avatar").textContent = person.avatar;
  document.getElementById("email").value = person.email;
  const [k, t, s] = copy[role];
  document.getElementById("tickets-kicker").textContent = k;
  document.getElementById("tickets-title").textContent = t;
  document.getElementById("tickets-sub").textContent = s;
  const nav = document.getElementById("nav");
  nav.innerHTML = "";
  navItems[role].forEach(([id, label]) => {
    const b = document.createElement("button");
    b.type = "button";
    b.textContent = label;
    b.dataset.go = id;
    if (id === view) b.setAttribute("aria-current", "page");
    nav.appendChild(b);
  });
  document.querySelectorAll(".roles button").forEach((b) => {
    b.setAttribute("aria-pressed", String(b.dataset.role === role));
  });
}

function show(next) {
  view = next;
  document.body.dataset.screen = next;
  const outside = next === "login" || next === "reset";
  document.getElementById("login").classList.toggle("is-on", next === "login");
  document.getElementById("reset").classList.toggle("is-on", next === "reset");
  document.getElementById("app").classList.toggle("is-on", !outside);
  const permitted = outside || access[role].includes(next);
  document.querySelectorAll(".view").forEach((el) => {
    const roleOk = !el.dataset.for || el.dataset.for.split(" ").includes(role);
    const showView = permitted ? el.dataset.view === next && roleOk : el.dataset.view === "denied";
    el.hidden = !showView;
  });
  jump.value = next;
  applyRoleVisibility();
}

document.body.addEventListener("click", (event) => {
  const roleBtn = event.target.closest(".roles button");
  if (roleBtn) {
    role = roleBtn.dataset.role;
    if (view !== "login" && view !== "reset" && !access[role].includes(view)) show("home");
    else show(view);
    return;
  }
  const go = event.target.closest("[data-go]");
  if (go) show(go.dataset.go);
});

jump.addEventListener("change", () => show(jump.value));

document.getElementById("signin-form").addEventListener("submit", (e) => {
  e.preventDefault();
  show("home");
});
document.getElementById("goto-reset").addEventListener("click", () => show("reset"));
document.getElementById("back-login").addEventListener("click", () => show("login"));
document.getElementById("signout").addEventListener("click", () => show("login"));
document.getElementById("reset-form").addEventListener("submit", (e) => {
  e.preventDefault();
  document.getElementById("reset-done").hidden = false;
});
document.getElementById("new-ticket").addEventListener("submit", (e) => {
  e.preventDefault();
  document.getElementById("new-result").textContent = "TKT-1057 created. The Hardware High clock starts now.";
  setTimeout(() => show("ticket"), 600);
});
document.querySelectorAll("tr.clickable").forEach((row) => {
  row.tabIndex = 0;
  row.setAttribute("role", "button");
  row.addEventListener("keydown", (event) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      row.click();
    }
  });
});
document.querySelectorAll(".cats .cat, .filters button").forEach((btn) => {
  btn.addEventListener("click", () => {
    const group = btn.parentElement;
    group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", "false"));
    btn.setAttribute("aria-pressed", "true");
  });
});
document.getElementById("tab-talk").addEventListener("click", () => {
  document.getElementById("pane-talk").hidden = false;
  document.getElementById("pane-time").hidden = true;
  document.getElementById("tab-talk").setAttribute("aria-pressed", "true");
  document.getElementById("tab-time").setAttribute("aria-pressed", "false");
});
document.getElementById("tab-time").addEventListener("click", () => {
  document.getElementById("pane-talk").hidden = true;
  document.getElementById("pane-time").hidden = false;
  document.getElementById("tab-talk").setAttribute("aria-pressed", "false");
  document.getElementById("tab-time").setAttribute("aria-pressed", "true");
});

show("login");
</script>
</body>
</html>
