# ==============================================================================
# ServiceOps Enterprise ITSM Platform — Master Environment Template
# ==============================================================================
# Copy this file to '.env' and adjust the values before running docker compose:
#   cp .env.example .env
# ==============================================================================

# --- [1] System & Deployment Configuration ---
NODE_ENV=production
DOMAIN_NAME=localhost
PORT=4000
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000

# --- [2] PostgreSQL 16 Relational Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=serviceops_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# --- [3] Redis 7 In-Memory Broker & Cache ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# --- [4] Cryptographic Authentication & Token Secrets ---
# IMPORTANT: Generate secure random 64-character strings for production!
# e.g., openssl rand -hex 32
JWT_ACCESS_SECRET=prod_access_secret_serviceops_minimum_32_characters_random_hex
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=prod_refresh_secret_serviceops_minimum_32_characters_random_hex
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=prod_cookie_signing_secret_serviceops_2026_super_secure

# --- [5] Transactional Email & Notifications (Brevo Dual Engine) ---
# Primary REST API: Use 'xkeysib-...' key
# Secondary SMTP: Use 'xsmtpsib-...' key with smtp-relay.brevo.com
BREVO_API_KEY=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=supportserviceops@gmail.com
BREVO_SENDER_NAME=ServiceOps Enterprise Support

# Legacy/Alternative SMTP Settings (if not using Brevo)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ServiceOps Support Desk <no-reply@serviceops.local>"

# System Alerts & Registration Approval Recipient
ADMIN_NOTIFICATION_EMAIL=supportserviceops@gmail.com

# --- [6] Production Observability (Prometheus & Grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=serviceops_grafana_secure_2026

# --- [7] Frontend Configuration ---
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
