# ServiceOps Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Prisma)
# Default PostgreSQL runs on port 5432. Adjust password if necessary.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/serviceops_db?schema=public"

# Authentication & Security
# In production, use cryptographically secure 256-bit keys
JWT_ACCESS_SECRET="dev_jwt_access_secret_serviceops_minimum_32_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="dev_jwt_refresh_secret_serviceops_minimum_32_characters_long"
JWT_REFRESH_EXPIRES_IN="7d"

COOKIE_SECRET="dev_cookie_signing_secret_serviceops_2026"

