# ==========================================
# ServiceOps Backend Environment Configuration
# ==========================================

# Server Runtime
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL 18 Relational Database (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/serviceops_db?schema=public"

# Identity & Cryptographic Security (Dual-Token Lifecycle)
JWT_ACCESS_SECRET="dev_jwt_access_secret_serviceops_minimum_32_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="dev_jwt_refresh_secret_serviceops_minimum_32_characters_long"
JWT_REFRESH_EXPIRES_IN="7d"

COOKIE_SECRET="dev_cookie_signing_secret_serviceops_2026"

# Redis 7 (Asynchronous Job Queue & WebSockets Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Outbound Email SMTP Gateway (BullMQ Notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ServiceOps Support Desk <no-reply@serviceops.local>"
